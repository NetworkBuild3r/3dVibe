# 3dvibe local / compose environment
# Copy to .env and adjust. Library paths should point at your NFS mount.

POSTGRES_USER=vibe
POSTGRES_PASSWORD=vibe
POSTGRES_DB=td_vibe_development

REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgres://vibe:vibe@db:5432/td_vibe_development

SECRET_KEY_BASE=replace-with-a-long-random-string
RAILS_ENV=development
RAILS_LOG_TO_STDOUT=1
RAILS_MAX_THREADS=5

# Active Record encryption for owner curator secrets (xAI key).
# Production: `bin/rails db:encryption:init` then set real values or Rails credentials
# (`active_record_encryption.primary_key` / `deterministic_key` / `key_derivation_salt`).
# These compose/CI defaults are deterministic and must not be used in production.
VIBE_ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=vibe-ci-primary-key-32bytes0001
VIBE_ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=vibe-ci-determ-key-32bytes0002
VIBE_ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=vibe-ci-derivation-salt-32b003

# Owner bootstrap (used by db:seed)
VIBE_OWNER_EMAIL=owner@3dvibe.local
VIBE_OWNER_PASSWORD=vibe-dev-password

# Absolute path to the on-disk / NFS library root.
# In Docker this is the path *inside* the api and worker containers.
VIBE_LIBRARY_ROOT=/library
VIBE_LIBRARY_NAME=Studio library

# Host path bind-mounted into api/worker as VIBE_LIBRARY_ROOT (read-write).
# Point this at your NFS mount (e.g. /mnt/nfs/models). Uploads write here.
VIBE_LIBRARY_HOST_PATH=./fixtures/library

# Per-file upload cap for contributor/owner resumable uploads.
VIBE_MAX_UPLOAD_BYTES=5368709120

# Optional NFS mount hints for the host (not consumed by the app process).
# Example: mount -t nfs -o ${VIBE_NFS_MOUNT_OPTIONS} ${VIBE_NFS_SERVER}:${VIBE_NFS_EXPORT} ${VIBE_LIBRARY_HOST_PATH}
VIBE_NFS_SERVER=
VIBE_NFS_EXPORT=
VIBE_NFS_MOUNT_OPTIONS=rw,hard,intr,noatime

# HITL AI curator sidecar.
# Rails: VIBE_CURATOR_URL=stub is the CI / default in-process fixture path.
# HTTP sidecar (compose profile `curator`) implements the same contract with
# pluggable providers. VIBE_CURATOR_PROVIDER does not replace the URL.
#   stub   — deterministic, no GPU (compose + CI default)
#   ollama — local OpenAI-compatible or native Ollama API
#   xai    — xAI Grok (needs XAI_API_KEY)
# docker compose --profile curator up --build
# VIBE_CURATOR_URL=http://curator:8088
VIBE_CURATOR_URL=stub
VIBE_CURATOR_PROVIDER=stub
VIBE_CURATOR_TOKEN=vibe-dev-curator
VIBE_CURATOR_TIMEOUT=8
VIBE_CURATOR_BATCH_SIZE=8
VIBE_CURATOR_CATALOG_LIMIT=80
VIBE_CURATOR_INFER_TIMEOUT=60
# Live sidecar quality knobs (stub ignores these so CI fixtures stay stable)
VIBE_CURATOR_MAX_PER_KIND=3
VIBE_CURATOR_KIND_PRIORITY=merge,organize,tag,rename,move
VIBE_CURATOR_MIN_CONFIDENCE=0
CURATOR_PORT=8088

# Ollama (used when VIBE_CURATOR_PROVIDER=ollama and URL is the HTTP sidecar)
VIBE_OLLAMA_URL=http://host.docker.internal:11434
VIBE_OLLAMA_MODEL=llama3.1
# openai = /v1/chat/completions; native/blank = /api/chat when URL has no /v1
VIBE_OLLAMA_API=
VIBE_OLLAMA_API_KEY=

# xAI (used when VIBE_CURATOR_PROVIDER=xai, or when owner UI key is unset)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4
# Aliases: VIBE_XAI_API_KEY / VIBE_XAI_BASE_URL / VIBE_XAI_MODEL
# Owner UI overrides: GET/PATCH /api/v1/curator_settings + PUT/DELETE .../xai_api_key
# Encrypted at rest. Never put the key in localStorage or chat.

# Printer bridge. The browser talks only to the Rails API; workers talk to printers.
# mock = in-process stub that always succeeds (CI/dev). Keep mock for CI.
# sdcp = SDCP-shaped LAN adapter (JSON WebSocket control + HTTP upload).
# Live jobs fail soft on timeout/unreachable — they never 502 the UI.
VIBE_PRINT_TIMEOUT=15
# Visible progress in compose. Tests leave this unset (instant).
VIBE_PRINT_MOCK_DELAY_MS=400
# SDCP (optional; host lives on the Printer row. Token/timeouts can also be printer.settings).
VIBE_SDCP_PORT=3030
VIBE_SDCP_TOKEN=
VIBE_SDCP_TIMEOUT=15
VIBE_SDCP_OPEN_TIMEOUT=3
VIBE_SDCP_WS_PATH=/websocket
VIBE_SDCP_UPLOAD_PATH=/uploadFile/upload
VIBE_SDCP_CLIENT_ID=3dvibe-sdcp
# Test-only simulated SDCP path. Ignored unless RAILS_ENV=test.
# VIBE_SDCP_STUB=1

# Meilisearch (started by default with docker compose up)
# API/worker index and search against this URL. Leave blank on the host to
# force the Postgres ILIKE fallback (CI does this).
MEILI_URL=http://meilisearch:7700
MEILISEARCH_URL=http://meilisearch:7700
MEILI_MASTER_KEY=vibe_dev_meili_key
# Optional search-only key. When blank, the API uses MEILI_MASTER_KEY for search too.
MEILI_SEARCH_KEY=
MEILI_TIMEOUT=2
# Coalesce unique model ids before a bulk Meili upsert (cover/scan/curation/creator).
# Gallery GET /models is Postgres (immediate). GET /search facets lag this window.
VIBE_SEARCH_INDEX_DEBOUNCE=2
VIBE_SEARCH_INDEX_BATCH=100
# Cheap /health reuse for GET /ops. Not index lag. 0 = probe every call.
VIBE_SEARCH_HEALTH_TTL=3
# Hard cap for Postgres ILIKE text fallback (chip-only filters are not capped).
VIBE_SEARCH_FALLBACK_CAP=250

# Archive visibility. Zip/3mf are fully listed from the central directory.
# 7z/rar listing and single-member extract are best-effort when `7z` is on PATH
# (compose API/worker images include p7zip-full).
VIBE_ARCHIVE_MEMBER_LIMIT=10000
VIBE_ARCHIVE_STREAM_BYTES=33554432
VIBE_ARCHIVE_PREVIEW_BYTES=4194304
VIBE_ARCHIVE_STREAM_SECONDS=30
VIBE_ARCHIVE_LIST_TIMEOUT=15
VIBE_PREVIEW_ROOT=
# VIBE_7Z_BIN=/usr/bin/7z

# Budgeted covers. Scan enqueues GenerateCoverJob; the worker generates a
# libvips thumbnail and writes back via CoverWriteback.apply!.
# POSTs /api/v1/covers/writeback (X-Cover-Token or a signed-in user) still work.
VIBE_COVER_TOKEN=

# Geometry digest write-back (X-Geometry-Token or a curator).
VIBE_GEOMETRY_TOKEN=
# ComputeGeometryDigestJob mesh fingerprint budget. 0 = unlimited.
# Quant is the vertex grid in model units (default 0.01).
VIBE_GEO_MAX_BYTES=67108864
VIBE_GEO_MAX_VERTS=250000
VIBE_GEO_MAX_SECONDS=20
VIBE_GEO_QUANT=0.01
VIBE_GEO_MAX_ASSETS=40
# AnalyzeDuplicatesJob hash budget. 0 = unlimited.
VIBE_DUP_MAX_SECONDS=60
VIBE_DUP_MAX_FILES=2000
VIBE_COVER_MAX_PX=512
VIBE_COVER_MAX_BYTES=250000
# Tiny LQIP / small-thumb webp written beside the full cover. Clamped to the cover budget.
VIBE_COVER_LQIP_MAX_PX=32
VIBE_COVER_LQIP_MAX_BYTES=2048
# Cover backlog pacing. 0 = unlimited for queue/batch. Pace is the drain tick delay.
# Scan still marks pending immediately; GenerateCoverJob is admitted in batches.
VIBE_COVER_QUEUE_MAX=40
VIBE_COVER_BATCH=20
VIBE_COVER_PACE_SECONDS=2
# Directory for generated cover webps (default api/tmp/covers). Served at /covers/:id.webp
# LQIP lives at /covers/:id.lqip.webp
VIBE_COVER_ROOT=

# Incremental NFS library scan. Polling + cursors — not inotify.
# Cron is loaded by the Sidekiq worker (sidekiq-cron). Set VIBE_SCAN_SCHEDULE=0 to disable.
VIBE_SCAN_SCHEDULE=1
VIBE_SCAN_CRON=0 */6 * * *
# Per-job caps. 0 = unlimited. A budgeted run saves ScanCursor/ScanRun resume and re-enqueues.
VIBE_SCAN_MAX_SECONDS=120
VIBE_SCAN_MAX_FILES=5000
VIBE_SCAN_MAX_FOLDERS=200
VIBE_SCAN_PRUNE_BATCH=50
# Seconds between mandatory deep walks of a folder whose dir mtime/inode/nlink look unchanged.
# In-place file edits on some NAS boxes do not bump the parent directory mtime.
VIBE_SCAN_DEEP_INTERVAL=21600
# 1 = skip the deep file walk when the first-level folder identity is unchanged (default).
VIBE_SCAN_TRUST_DIR_MTIME=1
# 0 = refuse to prune the catalog when the mount lists zero model folders (NFS outage).
VIBE_SCAN_ALLOW_EMPTY_PRUNE=0
# Isolated Sidekiq queue + capsule for IncrementalScanJob / ScheduledScanJob.
# Default: 1 scan thread, 5 threads for print/search/covers/curation/default.
# Overnight deep walks resume via VIBE_SCAN_MAX_* budgets; they must not share
# the API-critical pool. Reserved names (default/print/search/…) fall back to scan.
VIBE_SCAN_QUEUE=scan
VIBE_SCAN_CONCURRENCY=1
VIBE_SIDEKIQ_CONCURRENCY=5

# Frontend
VITE_API_BASE_URL=/api/v1
WEB_PORT=5173
API_PORT=3000

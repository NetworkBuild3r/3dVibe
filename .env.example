# 3dvibe local / compose environment
# Copy to .env and adjust. Library paths should point at your NFS mount.

POSTGRES_USER=vibe
POSTGRES_PASSWORD=vibe
POSTGRES_DB=td_vibe_development

REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgres://vibe:vibe@db:5432/td_vibe_development

SECRET_KEY_BASE=replace-with-a-long-random-string
RAILS_ENV=development
RAILS_LOG_TO_STDOUT=1
RAILS_MAX_THREADS=5

# Owner bootstrap (used by db:seed)
VIBE_OWNER_EMAIL=owner@3dvibe.local
VIBE_OWNER_PASSWORD=vibe-dev-password

# Absolute path to the on-disk / NFS library root.
# In Docker this is the path *inside* the api and worker containers.
VIBE_LIBRARY_ROOT=/library
VIBE_LIBRARY_NAME=Studio library

# Host path bind-mounted into api/worker as VIBE_LIBRARY_ROOT (read-write).
# Point this at your NFS mount (e.g. /mnt/nfs/models). Uploads write here.
VIBE_LIBRARY_HOST_PATH=./fixtures/library

# Per-file upload cap for contributor/owner resumable uploads.
VIBE_MAX_UPLOAD_BYTES=5368709120

# Optional NFS mount hints for the host (not consumed by the app process).
# Example: mount -t nfs -o ${VIBE_NFS_MOUNT_OPTIONS} ${VIBE_NFS_SERVER}:${VIBE_NFS_EXPORT} ${VIBE_LIBRARY_HOST_PATH}
VIBE_NFS_SERVER=
VIBE_NFS_EXPORT=
VIBE_NFS_MOUNT_OPTIONS=rw,hard,intr,noatime

# HITL AI curator sidecar.
# `stub` uses an in-process fixture generator (no GPU, works in CI).
# Point at the compose stub with:
#   docker compose --profile curator up
#   VIBE_CURATOR_URL=http://curator:8088
# Later, point at a Spark / DGX curator that implements the same HTTP contract.
VIBE_CURATOR_URL=stub
VIBE_CURATOR_TOKEN=vibe-dev-curator
VIBE_CURATOR_TIMEOUT=8
CURATOR_PORT=8088

# Printer bridge. The browser talks only to the Rails API; workers talk to printers.
# mock = in-process stub that always succeeds (CI/dev). sdcp = adapter interface only.
VIBE_PRINT_TIMEOUT=15
# Visible progress in compose. Tests leave this unset (instant).
VIBE_PRINT_MOCK_DELAY_MS=400

# Meilisearch (started by default with docker compose up)
# API/worker index and search against this URL. Leave blank on the host to
# force the Postgres ILIKE fallback (CI does this).
MEILI_URL=http://meilisearch:7700
MEILISEARCH_URL=http://meilisearch:7700
MEILI_MASTER_KEY=vibe_dev_meili_key
# Optional search-only key. When blank, the API uses MEILI_MASTER_KEY for search too.
MEILI_SEARCH_KEY=
MEILI_TIMEOUT=2

# Frontend
VITE_API_BASE_URL=/api/v1
WEB_PORT=5173
API_PORT=3000
